# Production origin: hostname only, no scheme or trailing slash.
CRM_HOST=stageforce.jaimo.me
# Published, versioned multi-platform image (amd64 and arm64).
CRM_IMAGE=ghcr.io/progries/stageforce:0.1.10

# Match the existing Traefik installation; Compose does not deploy Traefik.
TRAEFIK_NETWORK=reverse-proxy
TRAEFIK_ENTRYPOINT=web-secure
TRAEFIK_CERTRESOLVER=letsencrypt
# Existing middleware must allow the Gmail server-to-server integration.
# Set empty only if the administrator intentionally uses no middleware.
TRAEFIK_MIDDLEWARES=default@file
