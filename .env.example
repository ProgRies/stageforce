# Production origin: hostname only, no scheme or trailing slash.
CRM_HOST=stageforce.jaimo.me
# An exact, reviewed release (multi-platform, amd64 and arm64). Never a moving tag such as latest:
# whatever reaches main would otherwise go live on the next pull.
CRM_IMAGE=ghcr.io/progries/stageforce:0.3.16
# Traefik appends the client address to X-Forwarded-For; sign-in limits count per client address.
TRUST_PROXY=1

# Match the existing Traefik installation; Compose does not deploy Traefik.
TRAEFIK_NETWORK=reverse-proxy
TRAEFIK_ENTRYPOINT=web-secure
TRAEFIK_CERTRESOLVER=letsencrypt
# Existing middleware must let the browser extension reach /api/integrations/extension with its bearer key.
# Set empty only if the administrator intentionally uses no middleware.
TRAEFIK_MIDDLEWARES=default@file

# Automatic verified database snapshots inside the data volume.
# Hours between snapshots (0 disables) and how many healthy snapshots to keep.
SNAPSHOT_INTERVAL_HOURS=6
SNAPSHOT_KEEP=28
