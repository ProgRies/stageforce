{
 "manifest_version":3,"name":"Stage Force · Gmail","version":"0.4.1","minimum_chrome_version":"120",
 "description":"Review one Gmail message and save it to your own Stage Force CRM.",
 "permissions":["storage"],
 "optional_host_permissions":["http://localhost/*","http://127.0.0.1/*","https://*/*"],
 "background":{"service_worker":"worker.js","type":"module"},
 "options_page":"options.html","action":{"default_title":"Connect Stage Force"},
 "content_scripts":[{"matches":["https://mail.google.com/*"],"js":["date.js","extract.js","content.js"],"run_at":"document_idle"}]
}
